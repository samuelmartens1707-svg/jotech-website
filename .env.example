LEXOFFICE_API_KEY=
LEXOFFICE_API_BASE_URL=https://api.lexware.io/v1
LEXOFFICE_AUTO_FINALIZE=false

# Absolute Basis-URL der Website (ohne abschließenden Slash), wird für die
# Stripe-Checkout-Weiterleitungsziele (success_url/cancel_url) benötigt.
SITE_BASE_URL=https://jotech.de

# Stripe Checkout (Bestellprozess Shop). STRIPE_SECRET_KEY und STRIPE_WEBHOOK_SECRET
# stammen aus dem Stripe-Dashboard (Testmodus für Entwicklung: sk_test_..., Live erst
# nach Prüfung des Stripe-Kontos: sk_live_...). Der Webhook-Endpoint
# (.../api/stripe-webhook.php) muss im Stripe-Dashboard eingetragen werden, das dabei
# angezeigte Signing-Secret kommt in STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com/v1
STRIPE_API_VERSION=

# E-Mail-Adresse, an die eine Alarm-Mail geht, wenn ein Lexware-Office-Sync nach
# mehreren Versuchen endgültig fehlschlägt (siehe bin/retry-lexoffice-sync.php).
ADMIN_ALERT_EMAIL=

# Empfänger für Kontakt-/Ankauf-/Reparatur-Anfragen aus den Formularen auf der
# Website (siehe php/send-mail.php). Fallback ohne diese Variable: info@jotech.de.
INQUIRY_RECIPIENT_EMAIL=

# SMTP für den "Passwort vergessen"-Versand im Admin-Bereich sowie für
# Bestellbestätigungs- und Sync-Alarm-Mails.
# Solange SMTP_HOST leer ist, ist die Funktion inaktiv (kein Fehler, E-Mail wird nur nicht verschickt).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=JOTECH
SMTP_ENCRYPTION=tls
SMTP_ALLOW_SELF_SIGNED=false
